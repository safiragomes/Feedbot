// Schema derivado de docs/specs/modelo-dados.md (ver esse documento para as decisões de modelagem).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum MonitorStatus {
  ATIVO
  INATIVO
}

enum Semana {
  A
  B
}

enum BotSessaoStatus {
  DESCONECTADO
  CONECTANDO
  CONECTADO
}

model Periodo {
  id                     String    @id @default(cuid())
  nome                   String
  dataInicio             DateTime
  dataFim                DateTime
  dataReferenciaRodizio  DateTime
  ativo                  Boolean   @default(true)
  whatsappAvisosId       String?   @unique
  whatsappComunidadeNome String?
  planilhaId             String?
  planilhaUrl            String?
  planilhaVinculadaEm    DateTime?

  turmas        Turma[]
  gruposRevisao GrupoRevisao[]
  monitores     Monitor[]
  listas        Lista[]

  @@unique([nome])
}

model ConexaoGoogle {
  id                        String   @id @default("principal")
  email                     String
  refreshTokenCriptografado String
  conectadoEm               DateTime @default(now())
  atualizadoEm              DateTime @updatedAt
}

model Turma {
  id              String @id @default(cuid())
  periodoId       String
  nome            String
  nomeAbaPlanilha String

  periodo                  Periodo                   @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  alunos                   Aluno[]
  mapeamentosPlanilhaLista MapeamentoPlanilhaLista[]
  prazos                   PrazoLista[]

  @@unique([periodoId, nome])
}

model GrupoRevisao {
  id                String  @id @default(cuid())
  periodoId         String
  chefeId           String
  nome              String
  whatsappGrupoId   String?
  whatsappGrupoNome String?

  periodo Periodo @relation(fields: [periodoId], references: [id])
  chefe   Monitor @relation("GrupoRevisaoChefe", fields: [chefeId], references: [id])
  duplas  Dupla[]

  @@unique([whatsappGrupoId])
  @@unique([periodoId, chefeId])
}

model Dupla {
  id             String @id @default(cuid())
  grupoRevisaoId String
  label          String

  grupoRevisao GrupoRevisao @relation(fields: [grupoRevisaoId], references: [id], onDelete: Cascade)
  alunos       Aluno[]
  monitores    Monitor[]
  feedbacks    Feedback[]

  @@unique([grupoRevisaoId, label])
}

/// Um monitor pertence a no máximo uma dupla (a "dupla de monitores" que atende os
/// alunos dela); esse teto de 2 monitores por dupla é validado pela API de gestão,
/// não pelo schema. Para cada aluno da dupla, um dos dois é escolhido como monitor
/// da semana A (Aluno.monitorSemanaAId) — o outro é implicitamente o da semana B.
model Monitor {
  id             String        @id @default(cuid())
  nome           String
  whatsappNumero String        @unique
  isChefe        Boolean       @default(false)
  periodoId      String
  duplaId        String?
  status         MonitorStatus @default(ATIVO)

  periodo              Periodo            @relation(fields: [periodoId], references: [id])
  dupla                Dupla?             @relation(fields: [duplaId], references: [id], onDelete: SetNull)
  gruposComoChefe      GrupoRevisao[]     @relation("GrupoRevisaoChefe")
  alunosComoMonitorA   Aluno[]            @relation("AlunoMonitorSemanaA")
  feedbacksRegistrados Feedback[]
  contaChefe           ContaChefe?
  conviteContaChefe    ConviteContaChefe?
}

/// Credencial de acesso ao painel. Somente monitores marcados como chefes
/// podem possuir uma conta; a regra é validada pela API de gestão.
model ContaChefe {
  id           String   @id @default(cuid())
  monitorId    String   @unique
  email        String   @unique
  senhaHash    String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  monitor Monitor       @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  sessoes SessaoChefe[]
  recuperacoesSenha RecuperacaoSenha[]
}

model RecuperacaoSenha {
  id            String    @id @default(cuid())
  contaChefeId  String
  tokenHash     String    @unique
  expiraEm      DateTime
  usadoEm       DateTime?
  criadoEm      DateTime  @default(now())

  contaChefe ContaChefe @relation(fields: [contaChefeId], references: [id], onDelete: Cascade)

  @@index([contaChefeId])
  @@index([expiraEm])
}

/// Convite de uso único para o próprio chefe definir sua senha. O token em texto
/// puro existe somente no link enviado; o banco conserva apenas seu hash.
model ConviteContaChefe {
  id        String    @id @default(cuid())
  monitorId String    @unique
  email     String    @unique
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([expiraEm])
}

/// Sessões revogáveis, armazenando somente o hash do token enviado ao cliente.
model SessaoChefe {
  id           String   @id @default(cuid())
  contaChefeId String
  tokenHash    String   @unique
  expiraEm     DateTime
  criadoEm     DateTime @default(now())

  contaChefe ContaChefe @relation(fields: [contaChefeId], references: [id], onDelete: Cascade)

  @@index([contaChefeId])
  @@index([expiraEm])
}

model Aluno {
  id               String  @id @default(cuid())
  nome             String
  matricula        String  @unique
  turmaId          String
  duplaId          String?
  isPcd            Boolean @default(false)
  qtdQuestoesMeta  Int?
  monitorSemanaAId String?

  turma                      Turma                   @relation(fields: [turmaId], references: [id])
  dupla                      Dupla?                  @relation(fields: [duplaId], references: [id], onDelete: SetNull)
  monitorSemanaA             Monitor?                @relation("AlunoMonitorSemanaA", fields: [monitorSemanaAId], references: [id], onDelete: SetNull)
  feedbacks                  Feedback[]
  ocorrenciasPlagioEnvolvido FeedbackQuestaoPlagio[]
  prazosIndividuais          PrazoAlunoLista[]
}

model Lista {
  id               String  @id @default(cuid())
  periodoId        String
  nome             String
  qtdQuestoesTotal Int
  ordem            Int
  semanaOverride   Semana?

  periodo                  Periodo                   @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  feedbacks                Feedback[]
  mapeamentosPlanilhaLista MapeamentoPlanilhaLista[]
  prazos                   PrazoLista[]
  prazosIndividuais        PrazoAlunoLista[]

  @@unique([periodoId, nome])
  @@unique([periodoId, ordem])
}

/// Prazo de entrega de feedback por lista × turma — a mesma Lista (mesmo nome/ordem)
/// vale para todas as turmas do período, mas cada turma pode ter um prazo diferente.
/// Uma linha só existe depois que um chefe define o prazo daquela turma para aquela
/// lista; até lá, o par (lista, turma) fica sem prazo configurado (tratado como
/// "sem prazo" pela aplicação, não como erro).
model PrazoLista {
  id                   String   @id @default(cuid())
  listaId              String
  turmaId              String
  prazoEntregaFeedback DateTime

  lista Lista @relation(fields: [listaId], references: [id], onDelete: Cascade)
  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@unique([listaId, turmaId])
}

/// Exceção ao prazo da turma para um aluno específico. Quando existe, este é o
/// prazo efetivo usado nos indicadores de atraso.
model PrazoAlunoLista {
  id                   String   @id @default(cuid())
  alunoId              String
  listaId              String
  prazoEntregaFeedback DateTime

  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  lista Lista @relation(fields: [listaId], references: [id], onDelete: Cascade)

  @@unique([alunoId, listaId])
}

model Feedback {
  id                   String   @id @default(cuid())
  alunoId              String
  monitorId            String
  listaId              String
  duplaId              String?
  semana               Semana
  qtdQuestoesPontuadas Int
  usouIa               Boolean  @default(false)
  plagiou              Boolean  @default(false)
  usouProibicao        Boolean  @default(false)
  criadoEm             DateTime @default(now())
  sincronizadoPlanilha Boolean  @default(false)
  atualizadoEm         DateTime @updatedAt

  aluno             Aluno                      @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  monitor           Monitor                    @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  lista             Lista                      @relation(fields: [listaId], references: [id])
  dupla             Dupla?                     @relation(fields: [duplaId], references: [id], onDelete: SetNull)
  questoesIa        FeedbackQuestaoIA[]
  questoesPlagio    FeedbackQuestaoPlagio[]
  questoesProibicao FeedbackQuestaoProibicao[]

  @@unique([alunoId, listaId])
  @@index([alunoId])
  @@index([monitorId])
  @@index([listaId])
}

model FeedbackQuestaoIA {
  id            String @id @default(cuid())
  feedbackId    String
  numeroQuestao Int

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, numeroQuestao])
}

model FeedbackQuestaoPlagio {
  id               String @id @default(cuid())
  feedbackId       String
  numeroQuestao    Int
  alunoEnvolvidoId String

  feedback       Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  alunoEnvolvido Aluno    @relation(fields: [alunoEnvolvidoId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, numeroQuestao, alunoEnvolvidoId])
}

model FeedbackQuestaoProibicao {
  id            String @id @default(cuid())
  feedbackId    String
  numeroQuestao Int

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, numeroQuestao])
}

model MapeamentoPlanilhaLista {
  id                     String   @id @default(cuid())
  listaId                String
  turmaId                String
  colunaQuestoesCorretas String?
  atualizadoEm           DateTime @updatedAt

  lista Lista @relation(fields: [listaId], references: [id], onDelete: Cascade)
  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@unique([listaId, turmaId])
}

/// Tabela singleton: uma única linha reflete o estado de conexão do bot no dashboard
/// (ver docs/specs/modelo-dados.md e ADR-0003). Mantida por upsert com id fixo pela aplicação.
model BotSessao {
  id              String          @id @default(cuid())
  status          BotSessaoStatus @default(DESCONECTADO)
  numeroConectado String?
  atualizadoEm    DateTime        @updatedAt
}
