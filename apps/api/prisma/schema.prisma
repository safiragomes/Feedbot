// Schema derivado de docs/specs/modelo-dados.md (ver esse documento para as decisões de modelagem).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum MonitorStatus {
  ATIVO
  INATIVO
}

enum Semana {
  A
  B
}

enum BotSessaoStatus {
  DESCONECTADO
  CONECTANDO
  CONECTADO
}

model Periodo {
  id                     String    @id @default(cuid())
  nome                   String
  dataInicio             DateTime
  dataFim                DateTime
  dataReferenciaRodizio  DateTime
  ativo                  Boolean   @default(true)
  // Critério de desempate quando dois períodos têm o mesmo dataInicio — sem isso,
  // a ordem de retorno de /periodos (e portanto o período escolhido por padrão no
  // login) fica indefinida entre eles.
  criadoEm               DateTime  @default(now())
  // Cada período usa um servidor do Discord próprio (criado do zero a cada semestre) —
  // por isso servidor e cargo são configuração por período, não global do bot.
  discordGuildId         String?   @unique
  discordMonitoresRoleId String?
  discordAvisosCanalId   String?   @unique
  discordAvisosCanalNome String?
  planilhaId             String?
  planilhaUrl            String?
  planilhaVinculadaEm    DateTime?

  turmas        Turma[]
  gruposRevisao GrupoRevisao[]
  gruposPrazo   GrupoPrazo[]
  monitores     Monitor[]
  listas        Lista[]

  @@unique([nome])
}

model ConexaoGoogle {
  id                        String   @id @default("principal")
  email                     String
  refreshTokenCriptografado String
  conectadoEm               DateTime @default(now())
  atualizadoEm              DateTime @updatedAt
}

model Turma {
  id              String @id @default(cuid())
  periodoId       String
  nome            String
  nomeAbaPlanilha String

  periodo                  Periodo                   @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  alunos                   Aluno[]
  mapeamentosPlanilhaLista MapeamentoPlanilhaLista[]
  prazos                   PrazoLista[]

  @@unique([periodoId, nome])
}

model GrupoRevisao {
  id                String  @id @default(cuid())
  periodoId         String
  chefeId           String
  nome              String
  whatsappGrupoId   String?
  whatsappGrupoNome String?

  periodo Periodo @relation(fields: [periodoId], references: [id])
  chefe   Monitor @relation("GrupoRevisaoChefe", fields: [chefeId], references: [id])
  duplas  Dupla[]

  @@unique([whatsappGrupoId])
  @@unique([periodoId, chefeId])
}

/// Grupo de prazo: conceito de negócio independente de GrupoRevisao (não organiza
/// duplas nem atendimento, só agrupa alunos que compartilham o mesmo prazo de
/// entrega por lista). Um aluno pertence a no máximo um grupo de prazo por vez —
/// expresso pela FK opcional única em Aluno.grupoPrazoId, mesmo padrão de
/// Aluno.duplaId, sem precisar de tabela de associação.
model GrupoPrazo {
  id        String @id @default(cuid())
  periodoId String
  nome      String

  periodo Periodo          @relation(fields: [periodoId], references: [id])
  alunos  Aluno[]
  prazos  PrazoGrupoLista[]

  @@unique([periodoId, nome])
}

model Dupla {
  id             String @id @default(cuid())
  grupoRevisaoId String
  label          String

  grupoRevisao GrupoRevisao @relation(fields: [grupoRevisaoId], references: [id], onDelete: Cascade)
  alunos       Aluno[]
  monitores    Monitor[]
  feedbacks    Feedback[]

  @@unique([grupoRevisaoId, label])
}

/// Um monitor pertence a no máximo uma dupla (a "dupla de monitores" que atende os
/// alunos dela); esse teto de 2 monitores por dupla é validado pela API de gestão,
/// não pelo schema. Para cada aluno da dupla, um dos dois é escolhido como monitor
/// da semana A (Aluno.monitorSemanaAId) — o outro é implicitamente o da semana B.
model Monitor {
  id                 String        @id @default(cuid())
  nome               String
  // Histórico: chave de identidade do antigo bot de WhatsApp. Não é mais obrigatório
  // nem usado para autenticar o bot — ver discordUserId.
  whatsappNumero     String?       @unique
  discordUserId      String?       @unique
  discordUsername    String?
  discordDisplayName String?
  discordAvatarUrl   String?
  // Quando a chefe vinculou manualmente esse monitor a uma conta do Discord.
  discordVinculadoEm DateTime?
  isChefe            Boolean       @default(false)
  periodoId          String
  duplaId            String?
  status             MonitorStatus @default(ATIVO)

  periodo              Periodo            @relation(fields: [periodoId], references: [id])
  dupla                Dupla?             @relation(fields: [duplaId], references: [id], onDelete: SetNull)
  gruposComoChefe      GrupoRevisao[]     @relation("GrupoRevisaoChefe")
  alunosComoMonitorA   Aluno[]            @relation("AlunoMonitorSemanaA")
  feedbacksRegistrados Feedback[]
  contaChefe           ContaChefe?
  conviteContaChefe    ConviteContaChefe?
}

/// Credencial de acesso ao painel. Somente monitores marcados como chefes
/// podem possuir uma conta; a regra é validada pela API de gestão.
model ContaChefe {
  id           String   @id @default(cuid())
  monitorId    String   @unique
  email        String   @unique
  senhaHash    String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  monitor Monitor       @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  sessoes SessaoChefe[]
  recuperacoesSenha RecuperacaoSenha[]
}

model RecuperacaoSenha {
  id            String    @id @default(cuid())
  contaChefeId  String
  tokenHash     String    @unique
  expiraEm      DateTime
  usadoEm       DateTime?
  criadoEm      DateTime  @default(now())

  contaChefe ContaChefe @relation(fields: [contaChefeId], references: [id], onDelete: Cascade)

  @@index([contaChefeId])
  @@index([expiraEm])
}

/// Convite de uso único para o próprio chefe definir sua senha. O token em texto
/// puro existe somente no link enviado; o banco conserva apenas seu hash.
model ConviteContaChefe {
  id        String    @id @default(cuid())
  monitorId String    @unique
  email     String    @unique
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([expiraEm])
}

/// Sessões revogáveis, armazenando somente o hash do token enviado ao cliente.
model SessaoChefe {
  id           String   @id @default(cuid())
  contaChefeId String
  tokenHash    String   @unique
  expiraEm     DateTime
  criadoEm     DateTime @default(now())

  contaChefe ContaChefe @relation(fields: [contaChefeId], references: [id], onDelete: Cascade)

  @@index([contaChefeId])
  @@index([expiraEm])
}

model Aluno {
  id               String  @id @default(cuid())
  nome             String
  matricula        String  @unique
  turmaId          String
  duplaId          String?
  grupoPrazoId     String?
  isPcd            Boolean @default(false)
  qtdQuestoesMeta  Int?
  monitorSemanaAId String?

  turma                      Turma                   @relation(fields: [turmaId], references: [id])
  dupla                      Dupla?                  @relation(fields: [duplaId], references: [id], onDelete: SetNull)
  grupoPrazo                 GrupoPrazo?             @relation(fields: [grupoPrazoId], references: [id], onDelete: SetNull)
  monitorSemanaA             Monitor?                @relation("AlunoMonitorSemanaA", fields: [monitorSemanaAId], references: [id], onDelete: SetNull)
  feedbacks                  Feedback[]
  ocorrenciasPlagioEnvolvido FeedbackQuestaoPlagio[]
  prazosIndividuais          PrazoAlunoLista[]
}

model Lista {
  id               String  @id @default(cuid())
  periodoId        String
  nome             String
  qtdQuestoesTotal Int
  ordem            Int
  semanaOverride   Semana?

  periodo                  Periodo                   @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  feedbacks                Feedback[]
  mapeamentosPlanilhaLista MapeamentoPlanilhaLista[]
  prazos                   PrazoLista[]
  prazosGrupo              PrazoGrupoLista[]
  prazosIndividuais        PrazoAlunoLista[]

  @@unique([periodoId, nome])
  @@unique([periodoId, ordem])
}

/// Prazo de entrega de feedback por lista × turma — a mesma Lista (mesmo nome/ordem)
/// vale para todas as turmas do período, mas cada turma pode ter um prazo diferente.
/// Uma linha só existe depois que um chefe define o prazo daquela turma para aquela
/// lista; até lá, o par (lista, turma) fica sem prazo configurado (tratado como
/// "sem prazo" pela aplicação, não como erro).
model PrazoLista {
  id                   String   @id @default(cuid())
  listaId              String
  turmaId              String
  prazoEntregaFeedback DateTime

  lista Lista @relation(fields: [listaId], references: [id], onDelete: Cascade)
  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@unique([listaId, turmaId])
}

/// Prazo de entrega de feedback por lista × grupo de prazo — mesma forma de PrazoLista,
/// um nível de precedência acima da turma (ver domain/prazo.ts para a precedência
/// completa: exceção individual > grupo > turma). Uma linha só existe depois que um
/// chefe define o prazo daquele grupo para aquela lista; até lá, o par (grupo, lista)
/// fica sem prazo configurado (tratado como "sem prazo" pela aplicação, não como erro).
model PrazoGrupoLista {
  id                   String   @id @default(cuid())
  listaId              String
  grupoPrazoId         String
  prazoEntregaFeedback DateTime

  lista      Lista      @relation(fields: [listaId], references: [id], onDelete: Cascade)
  grupoPrazo GrupoPrazo @relation(fields: [grupoPrazoId], references: [id], onDelete: Cascade)

  @@unique([listaId, grupoPrazoId])
}

/// Exceção ao prazo da turma para um aluno específico. Quando existe, este é o
/// prazo efetivo usado nos indicadores de atraso.
model PrazoAlunoLista {
  id                   String   @id @default(cuid())
  alunoId              String
  listaId              String
  prazoEntregaFeedback DateTime

  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  lista Lista @relation(fields: [listaId], references: [id], onDelete: Cascade)

  @@unique([alunoId, listaId])
}

model Feedback {
  id                   String   @id @default(cuid())
  alunoId              String
  monitorId            String?
  // Retrato do nome do monitor no momento do registro. monitorId vira null se o
  // monitor for excluído (SetNull); este campo garante que o histórico continua
  // mostrando quem atendeu o aluno mesmo depois disso.
  monitorNome          String
  listaId              String
  duplaId              String?
  semana               Semana
  qtdQuestoesPontuadas Int
  // Distingue "respondeu e acertou 0" (qtdQuestoesPontuadas = 0, faltou = false) de
  // "não respondeu/entregou a lista" (faltou = true) — a planilha usa "F" pra esse
  // segundo caso em vez de um número.
  faltou               Boolean  @default(false)
  usouIa               Boolean  @default(false)
  plagiou              Boolean  @default(false)
  usouProibicao        Boolean  @default(false)
  criadoEm             DateTime @default(now())
  sincronizadoPlanilha Boolean  @default(false)
  atualizadoEm         DateTime @updatedAt

  aluno             Aluno                      @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  // O feedback é sobre o aluno; o monitor é só quem registrou. Excluir o monitor não
  // pode apagar o histórico acadêmico do aluno — só perde essa referência de autoria.
  monitor           Monitor?                   @relation(fields: [monitorId], references: [id], onDelete: SetNull)
  lista             Lista                      @relation(fields: [listaId], references: [id])
  dupla             Dupla?                     @relation(fields: [duplaId], references: [id], onDelete: SetNull)
  questoesIa        FeedbackQuestaoIA[]
  questoesPlagio    FeedbackQuestaoPlagio[]
  questoesProibicao FeedbackQuestaoProibicao[]

  @@unique([alunoId, listaId])
  @@index([alunoId])
  @@index([monitorId])
  @@index([listaId])
}

model FeedbackQuestaoIA {
  id            String @id @default(cuid())
  feedbackId    String
  numeroQuestao Int

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, numeroQuestao])
}

model FeedbackQuestaoPlagio {
  id               String @id @default(cuid())
  feedbackId       String
  numeroQuestao    Int
  alunoEnvolvidoId String

  feedback       Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  alunoEnvolvido Aluno    @relation(fields: [alunoEnvolvidoId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, numeroQuestao, alunoEnvolvidoId])
}

model FeedbackQuestaoProibicao {
  id            String @id @default(cuid())
  feedbackId    String
  numeroQuestao Int

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, numeroQuestao])
}

model MapeamentoPlanilhaLista {
  id                     String   @id @default(cuid())
  listaId                String
  turmaId                String
  colunaQuestoesCorretas String?
  atualizadoEm           DateTime @updatedAt

  lista Lista @relation(fields: [listaId], references: [id], onDelete: Cascade)
  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@unique([listaId, turmaId])
}

/// Tabela singleton: uma única linha reflete o estado de conexão do bot no dashboard
/// (ver docs/specs/modelo-dados.md e ADR-0003). Mantida por upsert com id fixo pela aplicação.
model BotSessao {
  id           String          @id @default(cuid())
  status       BotSessaoStatus @default(DESCONECTADO)
  discordBotTag String?
  guildNome    String?
  atualizadoEm DateTime        @updatedAt
}
