DATABASE_URL="postgresql://feedbot:feedbot@localhost:5435/feedbot?schema=public"
AUTH_BOOTSTRAP_SECRET="troque-por-um-segredo-longo-antes-de-subir-a-api"
PORT=3333
WEB_ORIGIN="http://localhost:5173"
APP_URL="http://localhost:5173"
# Ative somente atrás de proxy reverso confiável e sem acesso direto à API.
TRUST_PROXY="false"
# Servidor, cargo de monitores e canal de registro são configurados por período,
# pelo painel (tela Bot) — não são variáveis de ambiente, já que cada período usa um
# servidor do Discord próprio.
DISCORD_BOT_TOKEN=""
# O id da planilha de cada período é vinculado pelo painel (Gestão → Planilha,
# Periodo.planilhaId) — não é variável de ambiente.
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3333/google/oauth/callback"
# Gere com: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=""

# Convites para monitores-chefes concluírem o próprio cadastro.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Feedbot <feedbotip@gmail.com>"
