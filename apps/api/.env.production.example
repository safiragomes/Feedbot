# Segredo de uso único do POST /auth/bootstrap e do script bootstrap-producao.
# Gere com: openssl rand -base64 32
AUTH_BOOTSTRAP_SECRET=

# Integrações Google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Convites de acesso por Gmail (use uma senha de app, nunca a senha da conta)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=feedbotip@gmail.com
SMTP_PASS=
EMAIL_FROM="Feedbot <feedbotip@gmail.com>"

# Preencha temporariamente somente ao executar bootstrap:production e remova depois.
BOOTSTRAP_CHIEF_NAME=
BOOTSTRAP_CHIEF_EMAIL=
BOOTSTRAP_CHIEF_PASSWORD=
BOOTSTRAP_CHIEF_WHATSAPP=
BOOTSTRAP_PERIOD_NAME=
BOOTSTRAP_PERIOD_START=
BOOTSTRAP_PERIOD_END=
BOOTSTRAP_ROTATION_REFERENCE=
# Alternativa: use um período que já existe e deixe os quatro campos de período acima vazios.
BOOTSTRAP_PERIOD_ID=
